{
	"name": "@bobvarioa/sdi-framework",
	"description": "A simple DI / IOC framework for typescript.",
	"version": "1.0.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/BobVarioa/sdi-framework.git"
	},
	"type": "module",
	"scripts": {
		"build": "rolldown -c"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"rolldown": "^1.3.3"
	},
	"peerDependencies": {
		"typescript": "^7"
	},
	"dependencies": {
		"reflect-metadata": "^0.2.2",
		"rolldown-string": "^0.3.1"
	},
	"exports": {
		".": {
			"default": "./dist/index.js",
			"import": "./dist/index.js",
			"types": "./types/index.d.ts"
		},
		"./plugin": {
			"default": "./dist/plugin.js",
			"import": "./dist/index.js",
			"types": "./types/plugin.d.ts"
		}
	}
}
